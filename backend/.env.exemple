# --- Base de données ---
DB_NAME=wp_headless
DB_USER=wp_user
DB_PASSWORD=wp_password
DB_HOST=mysql
DB_CHARSET=utf8mb4
DB_COLLATE=utf8mb4_unicode_ci

# --- WordPress ---
WP_ENV=development
WP_HOME=http://localhost:8080
WP_SITEURL=http://localhost:8080
WP_DEBUG=true
WP_DEBUG_LOG=/var/www/html/web/wp-content/debug.log

# --- Cache ---
WP_CACHE=true
WP_CACHE_KEY_SALT=headless_wordpress

# --- Headless Bridge ---
HEADLESS_BRIDGE_PODS_SUPPORT=true
HEADLESS_BRIDGE_CACHE_ENABLED=true
HEADLESS_BRIDGE_CACHE_DRIVER=memcached
HEADLESS_BRIDGE_CACHE_TTL=3600

# --- LiteSpeed Cache ---
LSCACHE_OBJECT=true
LSCACHE_OBJECT_MEMCACHED_HOST=memcached
LSCACHE_OBJECT_MEMCACHED_PORT=11211

# --- JWT (Preview) ---
JWT_SECRET=ta_clef_secrete_jwt_12345

# --- Cloudflare ---
CLOUDFLARE_BUILD_HOOK=
