# --- Base de données ---
# Doit correspondre au .env racine (utilisé par le conteneur MySQL).
# Dans Docker : DB_HOST=mysql. Depuis WSL : DB_HOST=127.0.0.1:3307
DB_NAME=wp_headless
DB_USER=wp_user
DB_PASSWORD=wp_password
DB_HOST=mysql
DB_PREFIX=wp_
DB_CHARSET=utf8mb4
DB_COLLATE=utf8mb4_unicode_ci

# --- WordPress ---
WP_ENV=development
WP_HOME=http://cms.headless.localhost
# Bedrock : le cœur WordPress est dans web/wp
WP_SITEURL=${WP_HOME}/wp
WP_DEBUG=true
# true = web/wp-content/debug.log
WP_DEBUG_LOG=true
# Debug WPGraphQL (développement uniquement)
GRAPHQL_DEBUG=true

# --- Compte administrateur (créé au premier démarrage du conteneur) ---
WP_TITLE="Headless WordPress"
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change_moi
WP_ADMIN_EMAIL=admin@example.com

# --- Clés de sécurité (générer sur https://roots.io/salts.html) ---
AUTH_KEY='generateme'
SECURE_AUTH_KEY='generateme'
LOGGED_IN_KEY='generateme'
NONCE_KEY='generateme'
AUTH_SALT='generateme'
SECURE_AUTH_SALT='generateme'
LOGGED_IN_SALT='generateme'
NONCE_SALT='generateme'

# --- Cache ---
WP_CACHE=true
WP_CACHE_KEY_SALT=headless_wordpress

# --- LiteSpeed Cache ---
# Pas de serveur Memcached sur l'hébergement mutualisé Hostinger : false en production.
LSCACHE_OBJECT=true
LSCACHE_OBJECT_MEMCACHED_HOST=memcached
LSCACHE_OBJECT_MEMCACHED_PORT=11211

# --- JWT (Preview) : au moins 32 caractères ---
JWT_SECRET=change_moi_avec_une_cle_d_au_moins_32_caracteres

# --- Frontend Astro (bouton « Prévisualiser ») ---
FRONTEND_URL=http://headless.localhost

# --- Rebuild du frontend à chaque publication (GitHub Actions) ---
# Jeton « fine-grained » limité au dépôt, permission Contents: write. Vide = désactivé.
GITHUB_REBUILD_REPO=
GITHUB_REBUILD_TOKEN=
